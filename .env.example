# Copy this file to .env and fill in the values. Never commit .env.

# --- Gemini (required for AI features) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
# Total tries per Gemini call (retries on rate limits, overload, timeouts)
GEMINI_MAX_ATTEMPTS=3
# Free tier: each model has its own daily quota. When GEMINI_MODEL runs out or is overloaded,
# these are tried in order (comma-separated). Remove any your key can't use.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Minimum milliseconds between calls to the same model (stays under per-minute limits)
GEMINI_MIN_INTERVAL_MS=4000

# --- Server ---
PORT=3001
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Optional (16+ chars): require "Authorization: Bearer <token>" for every request that changes data.
# The web dev server adds it automatically, so the browser never sees it. Leave it unset for demos
# and for deployed sites (the built web app can't send it). "off" also means unset.
# API_TOKEN=

# --- Database (PostgreSQL) ---
# Default points at the embedded Postgres started by `npm run db:start` / `npm run dev`.
# These credentials only work locally. For a hosted database (Neon, Supabase, ...) paste its URL here.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/order_manager
DATABASE_POOL_MAX=10
# Data folder for the embedded Postgres, relative to the server/ folder
EMBEDDED_PG_DIR=./data/postgres
